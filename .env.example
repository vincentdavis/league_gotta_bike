# Django Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,dev-league.gotta.bike
INTERNAL_IPS=127.0.0.1
DJANGO_PORT=8002
CSRF_TRUSTED_ORIGINS=http://localhost:8002,https://dev-league.gotta.bike

# Sinch Verification API (for SMS phone verification)
# Get credentials from https://dashboard.sinch.com/verification/apps
SINCH_APPLICATION_KEY=
SINCH_APPLICATION_SECRET=
TEST_TO_PHONE_NUMBER=


# Email Configuration (django-anymail with Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Tests
TEST_TO_EMAIL=to_me@example.com

# Logfire Configuration (optional for local development)
# Get your token from https://logfire.pydantic.dev/
# Leave empty for local development to use console-only logging
LOGFIRE_TOKEN=

# Database (optional, defaults to SQLite)
# DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Media and Static (optional, uses defaults)
# MEDIA_ROOT=media
# STATIC_ROOT=staticfiles

# Cloudflare R2 Object Storage (optional, for production file uploads)
# Set USE_S3=True to enable R2 storage for media files (avatars, logos, etc.)
# When False, files are stored locally in MEDIA_ROOT directory
USE_S3=False
# Get credentials from Cloudflare R2 dashboard
# AWS_ACCESS_KEY_ID=your_r2_access_key_id
# AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# Optional: Custom domain for CDN delivery (e.g., cdn.yourdomain.com)
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com

# Superuser Credentials (optional, for automatic superuser creation)
# Use with: python manage.py ensure_superuser
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=changeme123

